# Copy to .env and fill in. Never commit .env.
# Leave SERPAPI_API_KEY empty to run fully offline on the recorded fixtures.

SERPAPI_API_KEY=

# fixtures (default when no key) | cache (live calls, SQLite read-through) | live (skip local cache)
BR_MODE=fixtures

# Guardrails for live calls. The Account API is free and is not counted.
SERPAPI_DAILY_CAP=40
MAX_LIVE_CALLS_PER_REPORT=14
MIN_SEARCHES_LEFT=20
